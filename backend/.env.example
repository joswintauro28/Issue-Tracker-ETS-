# Copy this file to .env and adjust values as needed.

# Application
PROJECT_NAME="Issue Tracker API"

# Security: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local development (default):
DATABASE_URL=sqlite:///./issue_tracker.db
# PostgreSQL (deployment) - requires `pip install "psycopg[binary]"`:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/issue_tracker

# Comma-separated list of allowed CORS origins (the frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
